  "day_of_year_functions": {
    "variable": "DJ = day of year (1-365)",
    "aliases": { "FDp": "FD_G (grass / pastizal)", "FDm": "FD_S (shrub / matorral)" },
    "dry_years": {
      "years": [1999, 2005],
      "FDp": "(sin(1.5*pi*(DJ + DJ**(1/3))/365))**6 * 0.55",
      "FDm": "((sin(1.55*pi*DJ/365))**2 + 0.65) * 0.5"
    },
    "normal_years": {
      "years": "all others in the series",
      "FDp": "(sin(1.5*pi*(DJ + DJ**(1/2))/365))**6 * 1.5",
      "FDm": "((sin(1.6*pi*DJ/365))**2 + 1) * 0.5"
    },
    "ocr_warning": "Eq. 2 (dry-year FDm) has unbalanced parentheses in the PDF; the bracketing given here is the reading consistent with Eq. 4."
  },
  "dfmc_model": {
    "code": "10-hour moisture code (US NFDRS, Bradshaw et al. 1983)",
    "expression": "1.0317*FMC_10h + 2.1608",
    "slope": 1.0317,
    "intercept": 2.1608,
    "applies_to": ["cured grass", "litter"],
    "note": "Joint equation for both dead fuel types. FFMC and 10-h code performed comparably; the 10-h code was selected because it needs only temperature and relative humidity."
  },
  "moisture_of_extinction": {
    "live": { "grass": 40, "shrub": 105 },
    "dead": { "behave_model_1_grass": 12, "behave_model_2_grass": 15, "behave_model_9_litter": 25 },
    "note": "Grasslands with FMC < 30% are treated as dead fuel."
  },
  "fmc_max_historical": {
    "grass": 340,
    "shrub": 210,
    "period": "1996-2005",
    "note": "Site-specific (Cabañeros); used as the FMC value where IP = 0."
  },
  "ignition_potential": {
    "above_me": "IP = (1 - ((FMC - ME) / (FMC_max - ME))) * 0.2",
    "below_me_as_printed": "IP = (0.2 + (ME - FMC) / (ME - FMC_min)) * 0.8",
    "below_me_corrected": "IP = 0.2 + ((ME - FMC) / (ME - FMC_min)) * 0.8",
    "correction_note": "The printed form gives IP = 0.16 at FMC = ME and 0.96 at FMC = FMC_min, contradicting the text (which specifies 0.2 to 1). Use the corrected form, or verify against Chuvieco et al. (2004), Can. J. For. Res. 34(11): 2284-2293.",
    "integration": "IP_f = IP_live * pct_live_fuel_load + IP_dead * (100 - pct_live_fuel_load)",
    "integration_note": "As printed, weights are on a 0-100 scale while IP is 0-1; a division by 100 is implied.",
    "live_fuel_load_source": "CORINE Land Cover 2000"
  },
  "spectral_indices": {
    "note": "Not defined in the paper; standard formulations from the cited sources.",
    "NDVI": "(NIR - RED) / (NIR + RED)",
    "NDII": "(NIR - SWIR) / (NIR + SWIR)",
    "VARI": "(GREEN - RED) / (GREEN + RED - BLUE)",
    "GVMI": "((NIR + 0.1) - (SWIR + 0.02)) / ((NIR + 0.1) + (SWIR + 0.02))"
  }
}
