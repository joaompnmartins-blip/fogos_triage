{
  "source": {
    "citation": "Yebra, M., Aguado, I., García, M., Nieto, H., Chuvieco, E., Salas, J. (2007). Fuel moisture estimation for fire ignition mapping. Wildfire 2007, Sevilla, Spain.",
    "short_ref": "Yebra et al. (2007)",
    "study_area": "Cabañeros National Park (calibration); Madrid, Castilla y León, Andalucía (validation)",
