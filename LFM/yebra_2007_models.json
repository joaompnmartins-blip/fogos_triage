      "vegetation": "grass",
      "sensor": "MODIS",
      "method": "RTM",
      "expression": "-6.7 + 131.4*LAI + 296.7*NDII",
      "intercept": -6.7,
      "terms": [
        { "predictor": "LAI", "coef": 131.4 },
