    {
      "id": "G4",
      "vegetation": "grass",
      "sensor": "AVHRR",
      "method": "empirical",
      "expression": "27.95 + 115.51*FDp + 331.86*NDVI - 1.194*Ts",
      "intercept": 27.95,
      "terms": [
        { "predictor": "FDp", "coef": 115.51 },
        { "predictor": "NDVI", "coef": 331.86 },
        { "predictor": "Ts", "coef": -1.194 }
      ],
      "r2": 0.85,
      "se_pct": 36.9,
      "validation_cabaneros": { "r2": 0.91, "slope": 0.89, "const": 10.46, "rmse": 27.43, "rmse_s": 13.50, "rmse_u": 23.88 }
    },
    {
      "id": "S1",
      "vegetation": "shrub",
      "sensor": "MODIS",
      "method": "empirical",
      "expression": "229.1 + 887.2*VARI - 300.7*GVMI",
