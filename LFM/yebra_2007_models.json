      "r2": 0.91,
      "se_pct": 30.1,
      "validation_cabaneros": { "r2": 0.91, "slope": 0.93, "const": 12.69, "rmse": 27.38, "rmse_s": 10.24, "rmse_u": 25.40 },
      "validation_other_sites": { "r2": 0.88, "slope": 0.78, "const": 36.39, "rmse": 42.60, "rmse_s": 27.56, "rmse_u": 32.48 }
    },
    {
      "id": "G2",
      "vegetation": "grass",
      "sensor": "MODIS",
      "method": "empirical",
      "expression": "-129.12 + 503.51*NDVI + 52.55*FD_G",
      "intercept": -129.12,
      "terms": [
        { "predictor": "NDVI", "coef": 503.51 },
        { "predictor": "FD_G", "coef": 52.55 }
      ],
      "r2": 0.93,
      "se_pct": 26.3,
      "validation_cabaneros": { "r2": 0.87, "slope": 0.93, "const": 14.70, "rmse": 33.41, "rmse_s": 11.90, "rmse_u": 31.22 },
      "validation_other_sites": { "r2": 0.90, "slope": 0.85, "const": 18.17, "rmse": 36.08, "rmse_s": 16.50, "rmse_u": 32.09 },
