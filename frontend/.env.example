# URL da API (Railway). Em desenvolvimento, o Vite faz proxy via /api.
# Em produção (build), é obrigatório definir esta variável.
VITE_API_URL=https://api-production-63014.up.railway.app

# Região visível no mapa/topbar. Opcionais — sem elas, o frontend mostra
# Portugal Continental (comportamento atual). Usadas nos deploys regionais
# (ex. piloto Alto Minho):
# VITE_REGION_BBOX=minLat,minLng,maxLat,maxLng
# VITE_REGION_CENTER=lng,lat
# VITE_REGION_ZOOM=zoom inicial
# VITE_REGION_LABEL=texto mostrado no topbar
#
# Exemplo (Alto Minho):
# VITE_REGION_BBOX=41.588,-8.910,42.172,-8.059
# VITE_REGION_CENTER=-8.48,41.88
# VITE_REGION_ZOOM=10
# VITE_REGION_LABEL=Alto Minho
